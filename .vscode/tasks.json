{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "shell",
      "command": "yarn",
      "args": ["compile"],
      "group": "build",
      "presentation": {
        "panel": "dedicated",
        "reveal": "never"
      },
      "problemMatcher": "$tsc"
    },
    {
      "type": "shell",
      "command": "yarn",
      "args": ["watch"],
      "group": "build",
      "presentation": {
        "panel": "dedicated",
        "reveal": "never"
      },
      "isBackground": true,
      "problemMatcher": "$tsc-watch"
    }
  ]
}
