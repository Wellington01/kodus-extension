{
  "name": "kodus-extension",
  "displayName": "Kodus Development Tools",
  "description": "Open source development tools and utilities for enhanced productivity",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other",
    "Linters",
    "Formatters",
    "Snippets"
  ],
  "activationEvents": [
    "onCommand:kodus-extension.welcome",
    "onCommand:kodus-extension.formatJson",
    "onCommand:kodus-extension.convertCase",
    "onCommand:kodus-extension.insertTimestamp",
    "onCommand:kodus-extension.insertSnippet",
    "onCommand:kodus-extension.configureAI",
    "onCommand:kodus-extension.startAIChat",
    "onCommand:kodus-extension.analyzeCode",
    "onCommand:kodus-extension.explainCode",
    "onView:kodus-extension.webview"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "kodus-extension.welcome",
        "title": "Welcome to Kodus Tools",
        "category": "Kodus"
      },
      {
        "command": "kodus-extension.formatJson",
        "category": "Kodus"
      },
      {
        "command": "kodus-extension.convertCase",
        "category": "Kodus"
      },
      {
        "command": "kodus-extension.insertTimestamp",
        "category": "Kodus"
      },
      {
        "command": "kodus-extension.insertSnippet",
        "category": "Kodus"
      },
      {
        "command": "kodus-extension.configureAI",
        "title": "Configure AI Assistant",
        "category": "Kodus"
      },
      {
        "command": "kodus-extension.startAIChat",
        "category": "Kodus"
      },
      {
        "command": "kodus-extension.analyzeCode",
        "title": "Analyze Code with AI",
        "category": "Kodus"
      },
      {
        "command": "kodus-extension.explainCode",
        "title": "Explain Code with AI",
        "category": "Kodus"
      },
      {
        "command": "kodus-extension.technicalInfo",
        "title": "Show Technical Info",
        "category": "Kodus"
      },
      {
        "command": "kodus-extension.advancedAnalysis",
        "title": "Advanced Code Analysis (AST/Diff/LSP)",
        "category": "Kodus"
      }
    ],
    "keybindings": [
      {
        "command": "kodus-extension.formatJson",
        "key": "ctrl+shift+f",
        "mac": "cmd+shift+f",
        "when": "editorTextFocus && resourceExtname == '.json'"
      },
      {
        "command": "kodus-extension.convertCase",
        "key": "ctrl+shift+c",
        "mac": "cmd+shift+c",
        "when": "editorTextFocus && editorHasSelection"
      },
      {
        "command": "kodus-extension.insertTimestamp",
        "key": "ctrl+shift+t",
        "mac": "cmd+shift+t",
        "when": "editorTextFocus"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "kodus-activitybar",
          "title": "Kodus Tools",
          "icon": "$(tools)"
        }
      ]
    },
    "views": {
      "kodus-activitybar": [
        {
          "type": "webview",
          "id": "kodus-extension.webview",
          "name": "Kodus Tools"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "yarn run compile",
    "compile": "node esbuild.config.js",
    "watch": "node esbuild.config.js --watch",
    "pretest": "yarn run compile && yarn run lint",
    "lint": "eslint src --ext ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "start": "./scripts/start.sh",
    "build": "node esbuild.config.js --production",
    "dev": "node esbuild.config.js --watch"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^24.9.0",
    "@types/vscode": "^1.105.0",
    "@typescript-eslint/eslint-plugin": "^8.46.1",
    "@typescript-eslint/parser": "^8.46.1",
    "esbuild": "^0.25.11",
    "eslint": "^9.38.0",
    "jest": "^29.7.0",
    "prettier": "^3.6.2",
    "ts-jest": "^29.1.2",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kodustech/kodus-extension.git"
  },
  "keywords": [
    "vscode",
    "extension",
    "development",
    "productivity",
    "open-source",
    "cross-platform",
    "tools",
    "utilities"
  ],
  "author": "Kodus Tech",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/kodustech/kodus-extension/issues"
  },
  "homepage": "https://github.com/kodustech/kodus-extension#readme",
  "dependencies": {
    "lit": "^3.3.1"
  }
}