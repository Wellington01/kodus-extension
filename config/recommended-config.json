{
    "compilerOptions": {
        "target": "ES2020",
        "module": "commonjs",
        "lib": [
            "ES2020"
        ],
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "resolveJsonModule": true,
        "declaration": true,
        "declarationMap": true,
        "sourceMap": true
    },
    "requiredSettings": [
        "target",
        "module",
        "strict",
        "esModuleInterop",
        "skipLibCheck"
    ],
    "recommendedSettings": {
        "target": "ES2020 or higher",
        "module": "commonjs",
        "strict": true,
        "sourceMap": true
    }
}