{
    "compilerOptions": {
        "target": "es2022",
        "module": "esnext",
        "moduleResolution": "Bundler",
        "lib": [
            "es2022",
            "DOM"
        ],
        "strict": true,
        "esModuleInterop": true,
        "experimentalDecorators": true,
        "isolatedModules": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "resolveJsonModule": true,
        "sourceMap": true,
        "baseUrl": ".",
        "paths": {
            "@/*": [
                "src/*"
            ],
            "@commands/*": [
                "src/commands/*"
            ],
            "@providers/*": [
                "src/providers/*"
            ],
            "@utils/*": [
                "src/utils/*"
            ],
            "@types/*": [
                "src/types/*"
            ],
            "@types": [
                "src/types/index"
            ],
            "@webview/*": [
                "src/webview/*"
            ]
        }
    },
    "requiredSettings": [
        "target",
        "module",
        "moduleResolution",
        "strict",
        "esModuleInterop",
        "skipLibCheck",
        "baseUrl",
        "paths"
    ],
    "recommendedSettings": {
        "target": "es2022",
        "module": "esnext",
        "moduleResolution": "Bundler",
        "strict": true,
        "sourceMap": true,
        "baseUrl": ".",
        "paths": "Path aliases for clean imports"
    },
    "expectedPaths": [
        "@/*",
        "@commands/*",
        "@providers/*",
        "@utils/*",
        "@types/*",
        "@types",
        "@webview/*"
    ]
}