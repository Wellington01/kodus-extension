{
    "esbuild": {
        "requiredOptions": [
            "entryPoints",
            "bundle",
            "outfile",
            "external",
            "format",
            "target",
            "platform"
        ],
        "aliasConfiguration": {
            "required": [
                "@",
                "@commands",
                "@providers",
                "@utils",
                "@types",
                "@webview"
            ]
        },
        "externalDependencies": [
            "vscode"
        ],
        "buildTargets": {
            "development": {
                "sourcemap": true,
                "minify": false
            },
            "production": {
                "sourcemap": false,
                "minify": true
            }
        }
    },
    "typescript": {
        "compilerOptions": {
            "required": [
                "target",
                "module",
                "moduleResolution",
                "strict",
                "esModuleInterop",
                "skipLibCheck",
                "baseUrl",
                "paths"
            ],
            "pathMapping": {
                "@/*": [
                    "src/*"
                ],
                "@commands/*": [
                    "src/commands/*"
                ],
                "@providers/*": [
                    "src/providers/*"
                ],
                "@utils/*": [
                    "src/utils/*"
                ],
                "@types/*": [
                    "src/types/*"
                ],
                "@types": [
                    "src/types/index"
                ],
                "@webview/*": [
                    "src/webview/*"
                ]
            }
        }
    },
    "packageJson": {
        "scripts": {
            "required": [
                "vscode:prepublish",
                "compile",
                "watch",
                "lint",
                "test"
            ]
        },
        "devDependencies": {
            "required": [
                "@types/vscode",
                "@types/node",
                "typescript",
                "esbuild"
            ]
        }
    }
}