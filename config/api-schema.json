{
    "vscodeAPI": {
        "requiredImports": [
            "vscode"
        ],
        "requiredMethods": [
            "registerWebviewViewProvider",
            "createWebviewPanel",
            "registerCommand"
        ],
        "extensionLifecycle": {
            "activate": {
                "required": [
                    "registerWebviewViewProvider",
                    "registerCommand",
                    "context.subscriptions.push"
                ]
            },
            "deactivate": {
                "required": [
                    "cleanup",
                    "dispose"
                ]
            }
        }
    },
    "mcpTools": {
        "toolDefinitions": [
            {
                "name": "code-analysis",
                "description": "Analyze code quality and suggest improvements",
                "input": "source code",
                "output": "analysis report"
            },
            {
                "name": "doc-generator",
                "description": "Generate documentation from code comments",
                "input": "code files",
                "output": "documentation"
            }
        ],
        "communication": {
            "requestFormat": {
                "command": "executeMcpTool",
                "toolName": "string",
                "data": "object"
            },
            "responseFormat": {
                "command": "mcpToolResult",
                "toolName": "string",
                "result": "object",
                "error": "string|null"
            }
        }
    },
    "githubIntegration": {
        "requiredEndpoints": [
            "GET /repos/{owner}/{repo}/pulls",
            "POST /repos/{owner}/{repo}/pulls",
            "PUT /repos/{owner}/{repo}/pulls/{pull_number}/merge"
        ],
        "messageHandlers": [
            "fetchGitHubPRs",
            "createGitHubPR",
            "autoMergePRs",
            "openGitHubPR"
        ],
        "dataStructures": {
            "pullRequest": {
                "required": [
                    "number",
                    "title",
                    "state",
                    "user",
                    "updated_at"
                ],
                "optional": [
                    "body",
                    "head",
                    "base",
                    "merged"
                ]
            }
        }
    }
}